datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                   String        @id @default(uuid())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  name                 String
  code                 String        @unique
  domain               String
  petrolPricePerLiter  Float         @default(101.50)
  dieselPricePerLiter  Float         @default(92.00)
  cngPricePerKg        Float         @default(78.00)
  evPricePerKwh        Float         @default(12.00)
  travelAllowancePerKm Float         @default(12.00)
  currency             String        @default("INR")
  users                User[]
  vehicles             Vehicle[]
  rides                Ride[]
  trips                Trip[]
}

model User {
  id             String         @id @default(uuid())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastActiveAt   DateTime       @default(now())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String         @unique
  mobileNumber   String?        @unique
  passwordHash   String
  fullName       String
  role           String         @default("EMPLOYEE")
  gender         String         @default("OTHER")
  department     String?
  workLocation   String?
  phone          String?
  avatarUrl      String?
  vehicles       Vehicle[]
  offeredRides   Ride[]         @relation("DriverRides")
  bookings       Booking[]
  driverTrips    Trip[]         @relation("DriverTrips")
  passengerTrips Trip[]         @relation("PassengerTrips")
  wallet         Wallet?
  savedPlaces    SavedPlace[]
  notifications  Notification[]
  messagesSent   Message[]
}

model OtpVerification {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  identifier  String   @unique
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
}

model Vehicle {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  make           String
  model          String
  color          String
  plateNumber    String       @unique
  totalSeats     Int          @default(4)
  fuelType       String       @default("Petrol")
  mileageKmL     Float        @default(17.5)
  isDefault      Boolean      @default(false)
  rides          Ride[]
}

model Ride {
  id                String       @id @default(uuid())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organizationId    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId          String
  driver            User         @relation("DriverRides", fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId         String
  vehicle           Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  originName        String
  originLat         Float
  originLng         Float
  destName          String
  destLat           Float
  destLng           Float
  departureTime     DateTime
  availableSeats    Int
  totalSeats        Int
  pricePerSeat      Float
  estimatedFuelCost Float        @default(0.0)
  isWomenOnly       Boolean      @default(false)
  distanceKm        Float
  durationMins      Int
  routePolyline     String
  isRecurring       Boolean      @default(false)
  status            String       @default("SCHEDULED")
  bookings          Booking[]
  trips             Trip[]
}

model Booking {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rideId      String
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   User     @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  seatsBooked Int      @default(1)
  totalFare   Float
  pickupName  String
  pickupLat   Float
  pickupLng   Float
  dropName    String
  dropLat     Float
  dropLng     Float
  boardingOtp String?
  isCheckedIn Boolean  @default(false)
  status      String   @default("CONFIRMED")
  trip        Trip?
}

model Trip {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rideId         String
  ride           Ride         @relation(fields: [rideId], references: [id], onDelete: Cascade)
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driverId       String
  driver         User         @relation("DriverTrips", fields: [driverId], references: [id], onDelete: Cascade)
  passengerId    String
  passenger      User         @relation("PassengerTrips", fields: [passengerId], references: [id], onDelete: Cascade)
  status         String       @default("BOOKED")
  boardingOtp    String?
  isCheckedIn    Boolean      @default(false)
  currentLat     Float?
  currentLng     Float?
  startedAt      DateTime?
  completedAt    DateTime?
  distanceKm     Float
  fareAmount     Float
  paymentStatus  String       @default("UNPAID")
  messages       Message[]
}

model Wallet {
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float         @default(0.0)
  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Float
  type          String   @default("CREDIT")
  description   String
  referenceId   String
  paymentMethod String   @default("INTERNAL_WALLET")
}

model SavedPlace {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float
  lng       Float
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("GENERAL")
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
}
